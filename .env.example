ENVIRONMENT=production

POSTGRES_DB=example
POSTGRES_USER=example
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://ticketing_app:replace-with-a-strong-database-password@your-neon-host/ticketing?sslmode=require

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=30
ADMIN_USERNAME=replace-with-a-unique-admin-name
ADMIN_PASSWORD=replace-with-a-strong-admin-password

ALLOWED_ORIGINS=https://your-public-hostname
ALLOWED_WS_ORIGINS=https://your-public-hostname
TRUSTED_PROXY_IPS=
WEBSOCKET_AUTH_TIMEOUT_SECONDS=10
WEBSOCKET_MAX_AUTH_MESSAGE_BYTES=4096
WEBSOCKET_MAX_CONNECTIONS=100
